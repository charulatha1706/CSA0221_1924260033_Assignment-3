#include <stdio.h>
#include <string.h>

#define MAX_NAMES 500
#define MAX_LENGTH 30

void sortNames(char names[][MAX_LENGTH], int n)
{
    char temp[MAX_LENGTH];
    int i, j;

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - i - 1; j++)
        {
            if (strcmp(names[j], names[j + 1]) > 0)
            {
                strcpy(temp, names[j]);
                strcpy(names[j], names[j + 1]);
                strcpy(names[j + 1], temp);
            }
        }
    }
}

int binarySearch(char names[][MAX_LENGTH], int n, char key[])
{
    int low = 0, high = n - 1, mid;

    while (low <= high)
    {
        mid = low + (high - low) / 2;

        int result = strcmp(names[mid], key);

        if (result == 0)
            return mid;

        if (result < 0)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

int main()
{
    char names[MAX_NAMES][MAX_LENGTH];
    char key[MAX_LENGTH];
    int n, i;

    printf("Enter number of names: ");
    scanf("%d", &n);
    getchar();

    if (n < 1 || n > MAX_NAMES)
    {
        printf("Invalid number of names.\n");
        return 1;
    }

    printf("Enter names:\n");

    for (i = 0; i < n; i++)
    {
        fgets(names[i], MAX_LENGTH, stdin);
        names[i][strcspn(names[i], "\n")] = '\0';
    }

    sortNames(names, n);

    printf("\nSorted Names:\n");

    for (i = 0; i < n; i++)
    {
        printf("%s\n", names[i]);
    }

    printf("\nDuplicate Names:\n");

    for (i = 0; i < n - 1; i++)
    {
        if (strcmp(names[i], names[i + 1]) == 0)
        {
            printf("%s\n", names[i]);
        }
    }

    printf("\nEnter name to search: ");
    fgets(key, MAX_LENGTH, stdin);
    key[strcspn(key, "\n")] = '\0';

    int position = binarySearch(names, n, key);

    if (position != -1)
        printf("Name found at position %d\n", position + 1);
    else
        printf("Name not found.\n");

    return 0;
}


