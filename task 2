Bubble sort:

#include <stdio.h>

void bubbleSort(int a[], int n)
{
    int comparisons = 0, swaps = 0;

    for (int i = 0; i < n - 1; i++)
    {
        int swapped = 0;

        for (int j = 0; j < n - i - 1; j++)
        {
            comparisons++;

            if (a[j] > a[j + 1])
            {
                int temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;

                swaps++;
                swapped = 1;
            }
        }

        if (swapped == 0)
            break;
    }

    printf("Bubble Sort Comparisons: %d\n", comparisons);
    printf("Bubble Sort Swaps: %d\n", swaps);
}

selection sort :

void selectionSort(int a[], int n)
{
    int comparisons = 0, swaps = 0;

    for (int i = 0; i < n - 1; i++)
    {
        int min = i;

        for (int j = i + 1; j < n; j++)
        {
            comparisons++;

            if (a[j] < a[min])
                min = j;
        }

        if (min != i)
        {
            int temp = a[i];
            a[i] = a[min];
            a[min] = temp;

            swaps++;
        }
    }

    printf("Selection Sort Comparisons: %d\n", comparisons);
    printf("Selection Sort Swaps: %d\n", swaps);
}

Insertion sort:

void insertionSort(int a[], int n)
{
    int comparisons = 0, shifts = 0;

    for (int i = 1; i < n; i++)
    {
        int key = a[i];
        int j = i - 1;

        while (j >= 0)
        {
            comparisons++;

            if (a[j] > key)
            {
                a[j + 1] = a[j];
                shifts++;
                j--;
            }
            else
                break;
        }

        a[j + 1] = key;
    }

    printf("Insertion Sort Comparisons: %d\n", comparisons);
    printf("Insertion Sort Shifts: %d\n", shifts);
}


